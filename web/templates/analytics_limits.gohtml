{{ define "content-analytics-limits" }}
<section class="hero">

  {{ template "page-header" . }}

  {{ if .FlashMessage }}
  <div class="flash-banner flash-banner--{{ .FlashKind }}">
    <p>{{ .FlashMessage }}</p>
  </div>
  {{ end }}

  <div class="analytics-actions">
    <a class="btn btn--ghost btn--sm" href="/analytics"><i data-lucide="arrow-left" class="icon-in-button"></i> {{ t "analytics.limits.back" }}</a>
  </div>

  {{ with .TrafficLimits }}
  <!-- Precedence explainer: how the effective cap is resolved per server -->
  <article class="card limits-precedence">
    <h3><i data-lucide="list-ordered"></i> {{ t "analytics.limits.precedence_title" }}</h3>
    <ol class="precedence-steps">
      <li class="precedence-step">
        <span class="precedence-step__rank" aria-hidden="true">1</span>
        <div class="precedence-step__body">
          <strong>{{ t "analytics.limits.precedence_server" }}</strong>
          <p>{{ t "analytics.limits.precedence_server_desc" }}</p>
        </div>
      </li>
      <li class="precedence-step">
        <span class="precedence-step__rank" aria-hidden="true">2</span>
        <div class="precedence-step__body">
          <strong>{{ t "analytics.limits.precedence_tag" }}</strong>
          <p>{{ t "analytics.limits.precedence_tag_desc" }}</p>
        </div>
      </li>
      <li class="precedence-step">
        <span class="precedence-step__rank" aria-hidden="true">3</span>
        <div class="precedence-step__body">
          <strong>{{ t "analytics.limits.precedence_global" }}</strong>
          <p>{{ t "analytics.limits.precedence_global_desc" }}</p>
        </div>
      </li>
    </ol>
  </article>

  <!-- Global default cap -->
  <article class="card analytics-limit">
    <div class="analytics-limit__head">
      <h3><i data-lucide="globe"></i> {{ t "analytics.limits.global_heading" }}</h3>
      {{ if .HasGlobal }}
      <span class="analytics-limit__current">{{ t "analytics.limit.current" "value" .GlobalHuman }}</span>
      {{ else }}
      <span class="analytics-limit__current analytics-limit__current--none">{{ t "analytics.limit.none" }}</span>
      {{ end }}
    </div>
    <p class="analytics-limit__hint">{{ t "analytics.limits.global_hint" }}</p>
    <form class="limit-form" method="post" action="{{ .GlobalAction }}">
      <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
      <label class="limit-form__field limit-form__field--value">
        <span>{{ t "analytics.limit.value_label" }}</span>
        <input type="number" name="limit_value" step="any" min="0"
               inputmode="decimal" value="{{ .GlobalValue }}"
               placeholder="{{ t "analytics.limit.placeholder" }}">
      </label>
      <label class="limit-form__field">
        <span>{{ t "analytics.limit.unit_label" }}</span>
        <select name="limit_unit">
          {{ $gunit := .GlobalUnit }}
          {{ range .UnitOptions }}<option value="{{ . }}"{{ if eq . $gunit }} selected{{ end }}>{{ . }}</option>{{ end }}
        </select>
      </label>
      <button type="submit" class="btn btn--primary btn--sm limit-form__submit"><i data-lucide="save" class="icon-in-button"></i> {{ t "analytics.limit.save" }}</button>
    </form>
    {{ if .HasGlobal }}
    <form method="post" action="{{ .GlobalAction }}" class="inline-form limit-remove">
      <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
      <input type="hidden" name="limit_value" value="">
      <button type="submit" class="btn btn--ghost btn--sm btn--danger-ghost" data-confirm="{{ t "analytics.limits.remove_confirm" }}"><i data-lucide="trash-2" class="icon-in-button"></i> {{ t "analytics.limit.remove" }}</button>
    </form>
    {{ end }}
  </article>

  <!-- Per-tag caps -->
  <article class="card analytics-limit">
    <div class="analytics-limit__head">
      <h3><i data-lucide="tags"></i> {{ t "analytics.limits.tag_heading" }}</h3>
    </div>
    <p class="analytics-limit__hint">{{ t "analytics.limits.tag_hint" }}</p>

    {{ if .Tags }}
    <div class="analytics-table-wrap">
      <table class="analytics-table">
        <thead>
          <tr>
            <th>{{ t "analytics.limits.col_tag" }}</th>
            <th class="text-right">{{ t "analytics.limits.col_limit" }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{ range .Tags }}
          <tr>
            <td><span class="tag-chip">{{ .Tag }}</span></td>
            <td class="text-right"><span class="traffic-badge">{{ .LimitHuman }}</span></td>
            <td class="text-right">
              <form method="post" action="{{ $.TrafficLimits.TagDeleteAction }}" class="inline-form">
                <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
                <input type="hidden" name="tag" value="{{ .Tag }}">
                <button type="submit" class="btn btn--ghost btn--xs btn--danger" data-confirm="{{ t "analytics.limits.remove_confirm" }}"><i data-lucide="trash-2" class="icon-in-button"></i> {{ t "analytics.limits.remove" }}</button>
              </form>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    {{ else }}
    <div class="empty-state-card empty-state-card--compact">
      <span class="empty-state-icon"><i data-lucide="tags"></i></span>
      <p class="empty-state-desc">{{ t "analytics.limits.no_tags" }}</p>
    </div>
    {{ end }}

    <form class="limit-form" method="post" action="{{ .TagAction }}">
      <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
      <label class="limit-form__field limit-form__field--value">
        <span>{{ t "analytics.limits.tag_label" }}</span>
        <input type="text" name="tag" maxlength="64"
               placeholder="{{ t "analytics.limits.tag_placeholder" }}">
      </label>
      <label class="limit-form__field limit-form__field--value">
        <span>{{ t "analytics.limit.value_label" }}</span>
        <input type="number" name="limit_value" step="any" min="0"
               inputmode="decimal" placeholder="{{ t "analytics.limit.placeholder" }}">
      </label>
      <label class="limit-form__field">
        <span>{{ t "analytics.limit.unit_label" }}</span>
        <select name="limit_unit">
          {{ range .UnitOptions }}<option value="{{ . }}">{{ . }}</option>{{ end }}
        </select>
      </label>
      <button type="submit" class="btn btn--primary btn--sm limit-form__submit"><i data-lucide="plus" class="icon-in-button"></i> {{ t "analytics.limits.add_tag" }}</button>
    </form>
  </article>
  {{ end }}

</section>
{{ end }}
