{{/* ── Install job fallback page ──────────────────────────────────────── */}}
{{ define "content-node-install" }}
<section class="hero nodes-page">
  {{ template "server-header" . }}
  <article class="card cmd-result-card stream-card{{ if .NodeInstall.IsRunning }} cmd-result-card--live{{ else if .NodeInstall.Error }} cmd-result-card--error{{ end }}"
    {{ if .NodeInstall.IsRunning }}data-stream-sse-url="/servers/{{ .NodeTarget.ID }}/nodes/install/{{ .NodeInstall.JobID }}/events" data-stream-page-url="{{ .NodeInstall.RefreshURL }}" data-stream-reload{{ end }}>
    <div class="result-header">
      <span class="result-header__label" data-stream-label>
        {{ if .NodeInstall.IsRunning }}<span class="spinner"></span> {{ t "nodes.installing" "name" .NodeInstall.NodeName }}
        {{ else if .NodeInstall.Error }}<i data-lucide="x-circle" class="icon-in-button" aria-hidden="true"></i> {{ t "nodes.install_failed" }}
        {{ else }}<i data-lucide="check-circle" class="icon-in-button" aria-hidden="true"></i> {{ t "nodes.installed" "name" .NodeInstall.NodeName }}
        {{ end }}
      </span>
      <div class="result-header__meta" data-stream-meta>
        <code class="result-duration">{{ .NodeInstall.Duration }}</code>
      </div>
    </div>
    {{ if .NodeInstall.Stages }}
    <div class="deploy-stages-bar">
      {{ range .NodeInstall.Stages }}
      <div class="deploy-stage-pill is-{{ .State }}"><span>{{ .Label }}</span></div>
      {{ end }}
    </div>
    {{ end }}
    {{ if .NodeInstall.Error }}<pre class="output-block output-block--error">{{ .NodeInstall.Error }}</pre>{{ end }}
    {{ if .NodeInstall.IsRunning }}
    <pre class="output-block scrollable" data-stream-stdout>{{ .NodeInstall.Output }}</pre>
    <p class="result-message" data-stream-status><span class="live-dot"></span> {{ t "nodes.install_streaming" }}</p>
    <div class="stream-connecting" aria-hidden="true"><span class="spinner spinner--lg"></span></div>
    {{ else }}
    {{ if .NodeInstall.Output }}<pre class="output-block scrollable">{{ .NodeInstall.Output }}</pre>{{ else }}<p class="empty-state">{{ t "nodes.waiting_output" }}</p>{{ end }}
    {{ end }}
  </article>

  {{ if .NodeInstall.Info.Available }}
  <article class="card node-register-card">
    <div class="card__header"><h3><i data-lucide="badge-check" aria-hidden="true"></i> {{ t "nodes.register_title" }}</h3></div>
    <p class="node-install-note">{{ t "nodes.register_note" }}</p>
    <div class="node-facts">
      <div class="node-fact"><span class="node-fact__label"><i data-lucide="box" aria-hidden="true"></i> {{ t "nodes.node_name" }}</span><span class="node-fact__value"><code>{{ .NodeInstall.Info.NodeName }}</code></span></div>
      <div class="node-fact"><span class="node-fact__label"><i data-lucide="globe" aria-hidden="true"></i> {{ t "nodes.node_ip" }}</span><span class="node-fact__value"><code>{{ .NodeInstall.Info.NodeIP }}</code></span></div>
      <div class="node-fact"><span class="node-fact__label"><i data-lucide="plug" aria-hidden="true"></i> {{ t "nodes.service_port" }}</span><span class="node-fact__value"><code class="node-port node-port--service">{{ .NodeInstall.Info.ServicePort }}</code></span></div>
      <div class="node-fact"><span class="node-fact__label"><i data-lucide="layers" aria-hidden="true"></i> {{ t "nodes.protocol" }}</span><span class="node-fact__value"><code>{{ .NodeInstall.Info.Protocol }}</code></span></div>
    </div>
    <div class="node-section">
      <div class="node-section__head">
        <span class="node-section__label"><i data-lucide="key-round" aria-hidden="true"></i> {{ t "nodes.api_key" }}</span>
        <button type="button" class="btn btn--ghost btn--sm copy-inline" data-copy-target="#nodeApiKeyValue" aria-label="{{ t "nodes.copy_api_key" }}"><i data-lucide="copy" class="icon-in-button" aria-hidden="true"></i> {{ t "nodes.copy" }}</button>
      </div>
      <pre id="nodeApiKeyValue" class="output-block node-secret-block" data-secret data-no-auto-copy>{{ .NodeInstall.Info.APIKey }}</pre>
    </div>
    <div class="node-section">
      <div class="node-section__head">
        <span class="node-section__label"><i data-lucide="shield-check" aria-hidden="true"></i> {{ t "nodes.ssl_cert" }}</span>
        {{ if .NodeInstall.Info.Certificate }}<button type="button" class="btn btn--ghost btn--sm copy-inline" data-copy-target="#nodeCertValue" aria-label="{{ t "nodes.copy_cert" }}"><i data-lucide="copy" class="icon-in-button" aria-hidden="true"></i> {{ t "nodes.copy" }}</button>{{ end }}
      </div>
      {{ if .NodeInstall.Info.Certificate }}<pre id="nodeCertValue" class="output-block scrollable node-secret-block" data-no-auto-copy>{{ .NodeInstall.Info.Certificate }}</pre>{{ else }}<p class="empty-state">{{ t "nodes.cert_missing" "name" .NodeInstall.Info.NodeName }}</p>{{ end }}
    </div>
    <div class="sys-form__actions">
      <a class="btn btn--primary" href="{{ .NodeInstall.NodesURL }}"><i data-lucide="arrow-left" class="icon-in-button" aria-hidden="true"></i> {{ t "nodes.back_to_nodes" }}</a>
    </div>
  </article>
  {{ end }}
</section>
{{ end }}
