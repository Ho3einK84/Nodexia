{{ define "content-analytics" }}
<section class="hero analytics-page analytics-server">

  {{ template "server-header" . }}
  {{ template "flash-banner" . }}

  <!-- Network Traffic Hero Section (always 30d from vnStat) -->
  <div class="analytics-traffic-hero">
    <article class="chart-card chart-card--hero chart-card--traffic an-enter" id="card-traffic" style="--stagger:0">
      <div class="chart-card__header">
        <div class="chart-card__title">
          <span class="chart-icon-badge chart-icon-badge--traffic" aria-hidden="true"><i data-lucide="network" class="chart-icon"></i></span>
          <span>{{ t "analytics.network_traffic" }}</span>
          <span class="chart-badge chart-badge--live"><span class="chart-badge__dot" aria-hidden="true"></span> {{ t "analytics.last_30_days" }}</span>
        </div>
        <div class="chart-card__meta">
          <span class="chart-card__live-val" id="live-traffic" hidden></span>
          <span class="chart-card__unit" dir="ltr">{{ t "analytics.unit_gb_day" }}</span>
        </div>
      </div>
      <div class="chart-wrap chart-wrap--tall">
        <div class="chart-skeleton an-shimmer" id="skeleton-traffic"></div>
        <div class="chart-container" id="chart-traffic" data-metric="traffic" data-server="{{ .AnalyticsTarget.ID }}" hidden></div>
        <div class="chart-empty" id="empty-traffic" hidden>
          <i data-lucide="wifi-off"></i>
          <p>{{ t "analytics.no_traffic" }}</p>
          <small>{{ t "analytics.no_traffic_sub" }}</small>
        </div>
        <div class="chart-error" id="error-traffic" hidden>
          <i data-lucide="alert-circle"></i>
          <p>{{ t "analytics.traffic_error" }}</p>
          <button type="button" class="btn btn--ghost btn--xs chart-retry-btn" data-chart-retry="traffic"><i data-lucide="refresh-cw" class="icon-in-button"></i> {{ t "analytics.retry" }}</button>
        </div>
      </div>
      <div class="chart-traffic-bottom">
        <div class="chart-legend" id="legend-traffic"></div>
        <div class="chart-card__footer chart-card__footer--inline" id="footer-traffic"></div>
      </div>
    </article>

    <!-- This month's traffic split (download vs upload) -->
    {{ with .AnalyticsTrafficMonth }}
    {{ if .HasData }}
    <div class="traffic-summary">
      <div class="traffic-summary__card traffic-summary__card--dl an-enter" style="--stagger:1">
        <div class="traffic-summary__top">
          <div class="traffic-summary__label">
            <span class="traffic-summary__icon traffic-summary__icon--dl" aria-hidden="true"><i data-lucide="arrow-down"></i></span>
            <span>{{ t "analytics.download" }}</span>
          </div>
          <span class="traffic-summary__pct traffic-summary__pct--dl">{{ .DownloadPct }}%</span>
        </div>
        <div class="traffic-summary__value" data-countup>{{ .Download }}</div>
        <div class="traffic-summary__meter" aria-hidden="true">
          <span class="traffic-summary__fill traffic-summary__fill--dl" data-an-bar style="--pct:{{ .DownloadPct }}"></span>
        </div>
        <div class="traffic-summary__sub">{{ t "analytics.this_month" "label" .MonthLabel }}</div>
      </div>
      <div class="traffic-summary__card traffic-summary__card--ul an-enter" style="--stagger:2">
        <div class="traffic-summary__top">
          <div class="traffic-summary__label">
            <span class="traffic-summary__icon traffic-summary__icon--ul" aria-hidden="true"><i data-lucide="arrow-up"></i></span>
            <span>{{ t "analytics.upload" }}</span>
          </div>
          <span class="traffic-summary__pct traffic-summary__pct--ul">{{ .UploadPct }}%</span>
        </div>
        <div class="traffic-summary__value" data-countup>{{ .Upload }}</div>
        <div class="traffic-summary__meter" aria-hidden="true">
          <span class="traffic-summary__fill traffic-summary__fill--ul" data-an-bar style="--pct:{{ .UploadPct }}"></span>
        </div>
        <div class="traffic-summary__sub">{{ t "analytics.this_month" "label" .MonthLabel }}</div>
      </div>
      <div class="traffic-summary__card traffic-summary__card--total an-enter" style="--stagger:3">
        <div class="traffic-summary__top">
          <div class="traffic-summary__label">
            <span class="traffic-summary__icon traffic-summary__icon--total" aria-hidden="true"><i data-lucide="arrow-up-down"></i></span>
            <span>{{ t "analytics.total" }}</span>
          </div>
          <span class="traffic-summary__ratio" dir="ltr">↓ {{ .DownloadPct }}% · ↑ {{ .UploadPct }}%</span>
        </div>
        <div class="traffic-summary__value" data-countup>{{ .Total }}</div>
        <div class="traffic-summary__split" aria-hidden="true">
          <div class="traffic-summary__split-inner" data-an-bar style="--pct:100">
            <span class="traffic-summary__split-rx" style="width:{{ .DownloadPct }}%"></span>
            <span class="traffic-summary__split-tx" style="width:{{ .UploadPct }}%"></span>
          </div>
        </div>
        <div class="traffic-summary__sub">{{ t "analytics.this_month" "label" .MonthLabel }}</div>
      </div>
    </div>
    {{ end }}
    {{ end }}
  </div>

  <!-- Scoped Resource Telemetry Section (controlled by 1H / 6H / 24H / 7D / 30D range tabs) -->
  <div class="analytics-section-bar an-enter" style="--stagger:1">
    <h2 class="analytics-section-title">
      <span class="an-section-icon" aria-hidden="true"><i data-lucide="activity" class="chart-icon"></i></span>
      <span>{{ t "monitoring.resource_health" }}</span>
    </h2>
    <div class="analytics-controls-bar">
      <div class="analytics-range-tabs" id="globalRangeTabs" role="tablist" aria-label="{{ t "analytics.time_range" }}">
        <span class="range-tab-indicator" id="rangeTabIndicator" aria-hidden="true"></span>
        <button type="button" class="range-tab" data-range="1h" role="tab" aria-selected="false" tabindex="-1">1H</button>
        <button type="button" class="range-tab" data-range="6h" role="tab" aria-selected="false" tabindex="-1">6H</button>
        <button type="button" class="range-tab active" data-range="24h" role="tab" aria-selected="true" tabindex="0">24H</button>
        <button type="button" class="range-tab" data-range="7d" role="tab" aria-selected="false" tabindex="-1">7D</button>
        <button type="button" class="range-tab" data-range="30d" role="tab" aria-selected="false" tabindex="-1">30D</button>
      </div>
      <button type="button" class="btn btn--ghost btn--sm an-refresh-btn" id="analyticsRefreshBtn" title="{{ t "analytics.refresh" }}" aria-label="{{ t "analytics.refresh" }}">
        <i data-lucide="refresh-cw" class="icon-in-button"></i>
        <span class="an-refresh-btn__label">{{ t "analytics.refresh" }}</span>
      </button>
    </div>
  </div>

  <!-- Resource Charts: CPU Hero + Secondary Telemetry Grid -->
  <div class="chart-grid" id="resourceChartGrid">

    <article class="chart-card chart-card--wide chart-card--cpu an-enter" id="card-cpu" style="--stagger:0">
      <div class="chart-card__header">
        <div class="chart-card__title">
          <span class="chart-icon-badge chart-icon-badge--cpu" aria-hidden="true"><i data-lucide="cpu" class="chart-icon"></i></span>
          <span>{{ t "analytics.cpu_usage" }}</span>
        </div>
        <div class="chart-card__meta">
          <span class="chart-card__live-val" id="live-cpu" hidden></span>
          <span class="chart-card__unit">%</span>
        </div>
      </div>
      <div class="chart-wrap chart-wrap--hero">
        <div class="chart-skeleton an-shimmer" id="skeleton-cpu"></div>
        <div class="chart-container" id="chart-cpu" data-metric="cpu" data-server="{{ .AnalyticsTarget.ID }}" hidden></div>
        <div class="chart-empty" id="empty-cpu" hidden>
          <i data-lucide="bar-chart-2"></i>
          <p>{{ t "analytics.no_data_range" }}</p>
        </div>
        <div class="chart-error" id="error-cpu" hidden>
          <i data-lucide="alert-circle"></i>
          <p>{{ t "analytics.chart_error" }}</p>
          <button type="button" class="btn btn--ghost btn--xs chart-retry-btn" data-chart-retry="cpu"><i data-lucide="refresh-cw" class="icon-in-button"></i> {{ t "analytics.retry" }}</button>
        </div>
      </div>
      <div class="chart-card__footer" id="footer-cpu"></div>
    </article>

    <article class="chart-card chart-card--ram an-enter" id="card-ram" style="--stagger:1">
      <div class="chart-card__header">
        <div class="chart-card__title">
          <span class="chart-icon-badge chart-icon-badge--ram" aria-hidden="true"><i data-lucide="memory-stick" class="chart-icon"></i></span>
          <span>{{ t "analytics.memory_usage" }}</span>
        </div>
        <div class="chart-card__meta">
          <span class="chart-card__live-val" id="live-ram" hidden></span>
          <span class="chart-card__unit">%</span>
        </div>
      </div>
      <div class="chart-wrap">
        <div class="chart-skeleton an-shimmer" id="skeleton-ram"></div>
        <div class="chart-container" id="chart-ram" data-metric="ram" data-server="{{ .AnalyticsTarget.ID }}" hidden></div>
        <div class="chart-empty" id="empty-ram" hidden>
          <i data-lucide="bar-chart-2"></i>
          <p>{{ t "analytics.no_data_range" }}</p>
        </div>
        <div class="chart-error" id="error-ram" hidden>
          <i data-lucide="alert-circle"></i>
          <p>{{ t "analytics.chart_error" }}</p>
          <button type="button" class="btn btn--ghost btn--xs chart-retry-btn" data-chart-retry="ram"><i data-lucide="refresh-cw" class="icon-in-button"></i> {{ t "analytics.retry" }}</button>
        </div>
      </div>
      <div class="chart-card__footer" id="footer-ram"></div>
    </article>

    <article class="chart-card chart-card--disk an-enter" id="card-disk" style="--stagger:2">
      <div class="chart-card__header">
        <div class="chart-card__title">
          <span class="chart-icon-badge chart-icon-badge--disk" aria-hidden="true"><i data-lucide="hard-drive" class="chart-icon"></i></span>
          <span>{{ t "analytics.disk_usage" }}</span>
        </div>
        <div class="chart-card__meta">
          <span class="chart-card__live-val" id="live-disk" hidden></span>
          <span class="chart-card__unit">%</span>
        </div>
      </div>
      <div class="chart-wrap">
        <div class="chart-skeleton an-shimmer" id="skeleton-disk"></div>
        <div class="chart-container" id="chart-disk" data-metric="disk" data-server="{{ .AnalyticsTarget.ID }}" hidden></div>
        <div class="chart-empty" id="empty-disk" hidden>
          <i data-lucide="bar-chart-2"></i>
          <p>{{ t "analytics.no_data_range" }}</p>
        </div>
        <div class="chart-error" id="error-disk" hidden>
          <i data-lucide="alert-circle"></i>
          <p>{{ t "analytics.chart_error" }}</p>
          <button type="button" class="btn btn--ghost btn--xs chart-retry-btn" data-chart-retry="disk"><i data-lucide="refresh-cw" class="icon-in-button"></i> {{ t "analytics.retry" }}</button>
        </div>
      </div>
      <div class="chart-card__footer" id="footer-disk"></div>
    </article>

    <article class="chart-card chart-card--load an-enter" id="card-load" style="--stagger:3">
      <div class="chart-card__header">
        <div class="chart-card__title">
          <span class="chart-icon-badge chart-icon-badge--load" aria-hidden="true"><i data-lucide="activity" class="chart-icon"></i></span>
          <span>{{ t "analytics.load_average" }}</span>
        </div>
        <div class="chart-card__meta">
          <span class="chart-card__live-val" id="live-load" hidden></span>
          <span class="chart-card__unit"></span>
        </div>
      </div>
      <div class="chart-wrap">
        <div class="chart-skeleton an-shimmer" id="skeleton-load"></div>
        <div class="chart-container" id="chart-load" data-metric="load" data-server="{{ .AnalyticsTarget.ID }}" hidden></div>
        <div class="chart-empty" id="empty-load" hidden>
          <i data-lucide="bar-chart-2"></i>
          <p>{{ t "analytics.no_data_range" }}</p>
        </div>
        <div class="chart-error" id="error-load" hidden>
          <i data-lucide="alert-circle"></i>
          <p>{{ t "analytics.chart_error" }}</p>
          <button type="button" class="btn btn--ghost btn--xs chart-retry-btn" data-chart-retry="load"><i data-lucide="refresh-cw" class="icon-in-button"></i> {{ t "analytics.retry" }}</button>
        </div>
      </div>
      <div class="chart-card__footer" id="footer-load"></div>
    </article>

  </div>

  <!-- Monthly traffic limit (optional; drives exhaustion forecasting) -->
  {{ with .AnalyticsLimit }}
  <article class="card analytics-limit an-card an-card--limit an-enter" style="--stagger:2">
    <div class="analytics-limit__head">
      <h3>
        <span class="an-card__emblem an-card__emblem--indigo" aria-hidden="true"><i data-lucide="gauge"></i></span>
        <span>{{ t "analytics.limit.title" }}</span>
      </h3>
      {{ if .HasLimit }}
      <span class="analytics-limit__current analytics-limit__current--active" data-limit-badge>{{ t "analytics.limit.current_kind" "value" .LimitHuman "kind" .KindLabel }}</span>
      {{ else if .InheritedHuman }}
      <span class="analytics-limit__current analytics-limit__current--inherited" data-limit-badge>{{ t "analytics.limit.inherited" "value" .InheritedHuman "source" .InheritedSource }}</span>
      {{ else }}
      <span class="analytics-limit__current analytics-limit__current--none" data-limit-badge>{{ t "analytics.limit.none" }}</span>
      {{ end }}
    </div>
    <p class="analytics-limit__hint">{{ t "analytics.limit.hint" }}</p>

    <div class="analytics-limit__quota{{ if .QuotaLevel }} analytics-limit__quota--{{ .QuotaLevel }}{{ end }}" data-limit-quota{{ if not .HasQuota }} hidden{{ end }}>
      <div class="analytics-limit__quota-top">
        <span class="analytics-limit__quota-text" data-limit-quota-text>{{ if .HasQuota }}{{ t "analytics.limit.quota_usage" "used" .QuotaUsedHuman "limit" .QuotaLimitHuman "kind" .QuotaKindLabel }}{{ end }}</span>
        <span class="analytics-limit__quota-pct" dir="ltr" data-limit-quota-pct>{{ if .HasQuota }}{{ .QuotaPct }}%{{ end }}</span>
      </div>
      <div class="analytics-limit__quota-meter" aria-hidden="true">
        <span class="analytics-limit__quota-fill" data-an-bar data-limit-quota-fill style="--pct:{{ .QuotaBarPct }}"></span>
      </div>
    </div>

    <div class="limit-presets" data-limit-presets>
      <span class="limit-presets__label">{{ t "analytics.limit.presets_label" }}</span>
      <button type="button" class="limit-preset-chip" data-preset-val="250" data-preset-unit="GB" dir="ltr">250 GB</button>
      <button type="button" class="limit-preset-chip" data-preset-val="500" data-preset-unit="GB" dir="ltr">500 GB</button>
      <button type="button" class="limit-preset-chip" data-preset-val="1" data-preset-unit="TB" dir="ltr">1 TB</button>
      <button type="button" class="limit-preset-chip" data-preset-val="2" data-preset-unit="TB" dir="ltr">2 TB</button>
      <button type="button" class="limit-preset-chip" data-preset-val="5" data-preset-unit="TB" dir="ltr">5 TB</button>
      <button type="button" class="limit-preset-chip" data-preset-val="10" data-preset-unit="TB" dir="ltr">10 TB</button>
    </div>

    <div class="limit-form-row">
      <form class="limit-form" method="post" action="{{ .Action }}" data-limit-form>
        <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
        <label class="limit-form__field limit-form__field--value">
          <span>{{ t "analytics.limit.value_label" }}</span>
          <input type="number" name="limit_value" step="any" min="0"
                 inputmode="decimal" value="{{ .ValueInput }}"
                 placeholder="{{ t "analytics.limit.placeholder" }}">
        </label>
        <label class="limit-form__field">
          <span>{{ t "analytics.limit.unit_label" }}</span>
          <select name="limit_unit">
            {{ $unit := .UnitInput }}
            {{ range .UnitOptions }}<option value="{{ . }}"{{ if eq . $unit }} selected{{ end }}>{{ . }}</option>{{ end }}
          </select>
        </label>
        <label class="limit-form__field">
          <span>{{ t "analytics.limit.kind_label" }}</span>
          <select name="limit_kind">
            <option value="rx"{{ if eq .KindInput "rx" }} selected{{ end }}>{{ t "analytics.limit.kind_rx" }}</option>
            <option value="tx"{{ if eq .KindInput "tx" }} selected{{ end }}>{{ t "analytics.limit.kind_tx" }}</option>
            <option value="total"{{ if eq .KindInput "total" }} selected{{ end }}>{{ t "analytics.limit.kind_total" }}</option>
          </select>
        </label>
        <button type="submit" class="btn btn--primary btn--sm limit-form__submit" data-no-loading><i data-lucide="save" class="icon-in-button"></i> {{ t "analytics.limit.save" }}</button>
      </form>
      <form method="post" action="{{ .Action }}" class="inline-form limit-remove" data-limit-remove-form{{ if not .HasLimit }} hidden{{ end }}>
        <input type="hidden" name="_csrf_token" value="{{ $.CSRFToken }}">
        <input type="hidden" name="limit_value" value="">
        <button type="submit" class="btn btn--ghost btn--sm btn--danger-ghost" data-no-loading data-confirm="{{ t "analytics.limits.remove_confirm" }}"><i data-lucide="trash-2" class="icon-in-button"></i> {{ t "analytics.limit.remove" }}</button>
      </form>
    </div>
    <p class="analytics-limit__error" data-limit-error{{ if not .Error }} hidden{{ end }}>{{ .Error }}</p>
  </article>
  {{ end }}

  <!-- Bandwidth Forecast (follows effective limit direction: RX / TX / Total) -->
  {{- $effKind := .AnalyticsLimit.EffectiveKind -}}
  <div class="forecast-header an-enter" style="--stagger:3">
    <p class="eyebrow forecast-eyebrow"><span class="an-dot an-dot--indigo" aria-hidden="true"></span> {{ t "analytics.forecast_eyebrow" }}</p>
    <h2 class="analytics-title">
      <span class="chart-icon-badge chart-icon-badge--forecast" aria-hidden="true"><i data-lucide="sparkles"></i></span>
      <span>{{ t "analytics.usage_forecast" }}</span>
      <span class="forecast-scope" id="forecastScopeBadge">
        {{- if eq $effKind "tx" -}}
          <i data-lucide="arrow-up"></i> <span>{{ t "analytics.upload" }}</span>
        {{- else if eq $effKind "total" -}}
          <i data-lucide="arrow-up-down"></i> <span>{{ t "analytics.total" }}</span>
        {{- else -}}
          <i data-lucide="arrow-down"></i> <span>{{ t "analytics.download" }}</span>
        {{- end -}}
      </span>
    </h2>
    <p class="analytics-subtitle" id="forecastSubtitle">
      {{- if eq $effKind "tx" -}}
        {{ tsafe "analytics.forecast_subtitle_tx" }}
      {{- else if eq $effKind "total" -}}
        {{ tsafe "analytics.forecast_subtitle_total" }}
      {{- else -}}
        {{ tsafe "analytics.forecast_subtitle" }}
      {{- end -}}
    </p>
  </div>

  <div class="forecast-grid" id="forecastGrid">
    <div class="forecast-skeleton an-shimmer"></div>
    <div class="forecast-skeleton an-shimmer"></div>
    <div class="forecast-skeleton an-shimmer"></div>
  </div>

  <!-- Days-to-exhaustion projection (only when a monthly limit is set) -->
  <div class="forecast-exhaustion" id="forecastExhaustion" hidden></div>

</section>
{{ end }}
