{{ define "layout" }}
<!doctype html>
<html lang="{{ .Lang }}" dir="{{ .Dir }}">
{{ template "head" . }}
{{ if eq .ContentTemplate "content-login" }}
{{/* The login page is an immersive, full-screen experience: it drops the app
     shell (sidebar / topbar / footer) entirely and renders only its own
     authentication view. Visitors here are not authenticated. */}}
<body class="auth-body">
  {{ .MainHTML }}
{{ else }}
<body>
  <div id="shell" class="shell">
    {{ template "shell-sidebar" . }}

    <div class="shell-workspace">
      <header class="shell-topbar">
        <a href="/" class="shell-topbar__brand">
          {{ template "brand-icon" . }}
          <span class="shell-topbar__title">{{ .AppName }}</span>
        </a>
        {{ template "tab-bar" . }}
        <button type="button" class="nav-toggle" data-drawer-open aria-label="{{ t "shell.menu.open" }}" aria-expanded="false" aria-controls="mobile-drawer">
          <i data-lucide="menu"></i>
        </button>
      </header>

      <main id="shell-main" class="shell-main">
        <div id="tab-content" class="tab-content" data-tab-content>
          {{ .MainHTML }}
        </div>
        <div id="tab-split-root" class="tab-split-root" data-tab-split-root hidden></div>
        <div id="loading-overlay" class="loading-overlay" hidden role="status" aria-live="polite">
          <div class="loading-spinner"></div>
          <p class="loading-overlay__label">{{ t "shell.loading" }}</p>
        </div>
      </main>

      {{ template "footer" . }}
    </div>
  </div>

  {{ template "mobile-drawer" . }}
  {{ template "bottom-nav" . }}
  {{ template "tab-switcher" . }}
  {{ template "tab-fab" . }}
{{ end }}

  {{/* Client i18n island: only the strings the JS needs, in the active locale.
       type="application/json" is data, not script, so it is exempt from the
       strict script-src CSP; app.js parses it and exposes window.nxT/nxTn. */}}
  <script type="application/json" id="nodexia-i18n">{{ clientI18nJSON }}</script>
  <script type="module" src="{{ asset "/static/app.js" }}"></script>
  <script src="{{ asset "/static/tab-manager.js" }}"></script>
  {{ range .PageScripts }}<script src="{{ asset . }}"></script>
  {{ end }}
</body>
</html>
{{ end }}
